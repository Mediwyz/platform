# NestJS Backend Environment Variables
DATABASE_URL=postgresql://healthwyz:healthwyz_secret@127.0.0.1:5432/healthwyz
JWT_SECRET=mediwyz-dev-secret-change-in-production
API_PORT=3001
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
SUPER_ADMIN_EMAIL=admin@mediwyz.com
SUPER_ADMIN_PASSWORD=Admin123!

# Groq AI
GROQ_API_KEY=gsk_your_groq_api_key_here

# SMTP Email (leave blank in dev — Ethereal test account auto-created)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MediWyz <noreply@mediwyz.com>

# Web Push (generate keys: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:admin@mediwyz.com

# Payment gateway: mock | mcb_juice
PAYMENT_GATEWAY=mock
MCB_JUICE_API_KEY=
MCB_JUICE_MERCHANT_ID=

# Sentry (optional — leave blank to disable error tracking)
SENTRY_DSN=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://mediwyz.com
